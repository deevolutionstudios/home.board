// Cloudflare Workers configuration for the Home Board (TanStack Start / nitro).
// `npm run build` produces dist/server/index.mjs (SSR worker) and dist/client (static assets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-board",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "keep_vars": true,
  "vars": {
    "GOOGLE_CALENDAR_IDS": "richardandraja@gmail.com"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
